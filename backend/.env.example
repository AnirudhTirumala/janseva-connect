# Environment - "development" (default, local work) or "production".
# In production the app refuses to start unless SECRET_KEY, DATABASE_URL,
# STORAGE_PATH, SMTP_*, CORS_ORIGINS and ALLOWED_HOSTS are all set properly
# (see app/main.py) - it fails loudly rather than running insecurely.
ENVIRONMENT=development

# Database
# For local dev, leave this line commented out - SQLite is used automatically.
# For production, set one database URL. SQLAlchemy creates the full schema on first start.
# PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/panchayat_db
# MySQL:      DATABASE_URL=mysql+pymysql://user:password@host:3306/panchayat_db?charset=utf8mb4

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Assistant (Groq - free tier)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Groq retires older models over time - check https://console.groq.com/docs/deprecations
# if the assistant starts erroring again, and update this to whatever they recommend.
GROQ_MODEL=openai/gpt-oss-120b

# Email OTP (citizen passwordless login)
# Using Gmail as an example - create an "App Password" at
# https://myaccount.google.com/apppasswords (needs 2-Step Verification enabled).
# Do NOT use your normal Gmail password here.
# If left blank, OTP codes are printed to the backend console instead of emailed,
# so you can still test the flow locally without setting this up.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_NAME=JanSeva Connect
OTP_EXPIRY_MINUTES=10

# Required in production: a mounted persistent volume for uploaded identity
# documents and generated PDFs. Keep unset for local development.
# STORAGE_PATH=/var/data/janseva

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# Required in production: comma-separated API hostnames (no protocol and no *)
# ALLOWED_HOSTS=your-backend.onrender.com
